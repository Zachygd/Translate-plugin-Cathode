// Cathode Translate: let @USER@ start/stop the Ollama service from the tray
// menu without a password prompt. Applies to this one service only.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "@SERVICE@.service" &&
      subject.user == "@USER@") {
    return polkit.Result.YES;
  }
});
